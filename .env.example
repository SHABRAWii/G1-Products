# Copy to .env.local for local development. Never commit real provider credentials.
NEXT_PUBLIC_APP_NAME=RoboMotion
DATABASE_URL=postgresql://robomotion:robomotion@localhost:5432/robomotion?schema=public
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=robomotion
OBJECT_STORAGE_ACCESS_KEY=robomotion
OBJECT_STORAGE_SECRET_KEY=replace-for-non-local-environments
RUNPOD_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Real local GPU pipeline. PromptHMR and GMR run in their own Conda environments.
ROBOMOTION_PROMPTHMR_ROOT=/absolute/path/to/PromptHMR
ROBOMOTION_GMR_ROOT=/absolute/path/to/GMR
ROBOMOTION_PROMPTHMR_ENV=phmr
ROBOMOTION_GMR_ENV=gmr
ROBOMOTION_WORKER_POLL_MS=2500
