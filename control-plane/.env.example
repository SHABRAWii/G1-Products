POSTGRES_PASSWORD=replace-with-a-long-random-password
OBJECT_STORAGE_BUCKET=robomotion
OBJECT_STORAGE_ACCESS_KEY=robomotion-control
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-password
APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
# Keep worker-only services on loopback. RunPod reaches them through the
# restricted SSH forwards created by deploy/start-runpod-gpu-plane.sh.
CONTROL_PRIVATE_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
OBJECT_STORAGE_PORT=9000

# Directory containing the generated official Unitree G1 *.compiled.stl files.
ROBOMOTION_WEB_MODEL_SOURCE=../.robomotion/cache/unitree-g1-web

# Enable the `runpod` Compose profile only after these are configured.
RUNPOD_API_KEY=
RUNPOD_POD_ID=
RUNPOD_GPU_IMAGE=
RUNPOD_IDLE_AFTER_SECONDS=900
RUNPOD_CONTROLLER_POLL_MS=5000

ROBOMOTION_DIGITAL_TWIN_FPS=60
ROBOMOTION_DIGITAL_TWIN_CRF=15
