POSTGRES_PASSWORD=replace-with-a-strong-server-password
OBJECT_STORAGE_BUCKET=robomotion
OBJECT_STORAGE_ACCESS_KEY=robomotion
OBJECT_STORAGE_SECRET_KEY=replace-with-a-strong-storage-password
APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1

# Current verified static-camera profile. Increase deliberately after GPU and
# output-quality validation on representative footage.
ROBOMOTION_POSE_MAX_HEIGHT=480
ROBOMOTION_POSE_FPS=12
ROBOMOTION_POSE_MAX_FRAMES=180
GPU_SHM_SIZE=8gb
ROBOMOTION_DIGITAL_TWIN_FPS=60
ROBOMOTION_DIGITAL_TWIN_CRF=15
# Optional GPU device IDs. Leave blank on a single-GPU server so both workers
# use the available GPU; assign distinct IDs only when the server has multiple
# GPUs and the workloads should be isolated.
ROBOMOTION_MOTION_GPU=
ROBOMOTION_TRAINING_GPU=

# Optional. PromptHMR may fetch public Hugging Face assets faster with a token.
HF_TOKEN=

# Paths on the deployment host. These files are Docker secrets and are read once
# by the model bootstrap service; they are not copied into either image.
SMPLX_USERNAME_SECRET_FILE=/secure/secrets/smplx_username.txt
SMPLX_PASSWORD_SECRET_FILE=/secure/secrets/smplx_password.txt
SMPL_USERNAME_SECRET_FILE=/secure/secrets/smpl_username.txt
SMPL_PASSWORD_SECRET_FILE=/secure/secrets/smpl_password.txt
