{
  "name": "robomotion-gpu-plane",
  "imageName": "ghcr.io/OWNER/robomotion-gpu@sha256:replace-me",
  "gpuTypeIds": ["NVIDIA GeForce RTX 4090"],
  "gpuCount": 1,
  "containerDiskInGb": 100,
  "volumeInGb": 300,
  "volumeMountPath": "/workspace",
  "dockerStartCmd": ["bash", "deploy/start-runpod-gpu-plane.sh"],
  "env": {
    "ROBOMOTION_WORKER_STAGES": "pose_extraction,robot_retargeting,visualization,training",
    "ROBOMOTION_MODEL_CACHE": "/workspace/models",
    "ROBOMOTION_MODEL_ROOT": "/workspace/robomotion",
    "CONDA_ENVS_PATH": "/workspace/conda-envs",
    "CONDA_PKGS_DIRS": "/workspace/conda-pkgs",
    "ROBOMOTION_PROMPTHMR_ROOT": "/opt/prompt-hmr",
    "ROBOMOTION_GMR_ROOT": "/opt/gmr",
    "ROBOMOTION_TRAIN_ROOT": "/opt/unitree-rl-mjlab",
    "ROBOMOTION_CONTROL_SSH_HOST": "dashboard.example.com",
    "ROBOMOTION_CONTROL_SSH_USER": "robomotion-tunnel",
    "ROBOMOTION_CONTROL_SSH_KEY": "{{ RUNPOD_SECRET_robomotion_control_ssh_key }}",
    "ROBOMOTION_CONTROL_SSH_KNOWN_HOSTS": "{{ RUNPOD_SECRET_robomotion_control_ssh_known_hosts }}",
    "ROBOMOTION_DB_PASSWORD": "{{ RUNPOD_SECRET_robomotion_db_password }}",
    "OBJECT_STORAGE_BUCKET": "robomotion",
    "OBJECT_STORAGE_ACCESS_KEY": "robomotion-control",
    "OBJECT_STORAGE_SECRET_KEY": "{{ RUNPOD_SECRET_robomotion_object_storage_secret }}",
    "SMPLX_USERNAME": "{{ RUNPOD_SECRET_robomotion_smplx_username }}",
    "SMPLX_PASSWORD": "{{ RUNPOD_SECRET_robomotion_smplx_password }}",
    "SMPL_USERNAME": "{{ RUNPOD_SECRET_robomotion_smpl_username }}",
    "SMPL_PASSWORD": "{{ RUNPOD_SECRET_robomotion_smpl_password }}",
    "HF_TOKEN": "{{ RUNPOD_SECRET_robomotion_hf_token }}",
    "WANDB_API_KEY": "{{ RUNPOD_SECRET_robomotion_wandb_api_key }}"
  }
}
