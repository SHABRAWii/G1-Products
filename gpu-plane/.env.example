# Private control-plane endpoints reachable over the deployment VPN.
DATABASE_URL=postgresql://gpu_worker:replace-me@control.internal:5432/robomotion?schema=public
OBJECT_STORAGE_ENDPOINT=https://objects.internal.example
OBJECT_STORAGE_BUCKET=robomotion
OBJECT_STORAGE_ACCESS_KEY=gpu-worker
OBJECT_STORAGE_SECRET_KEY=replace-with-a-scoped-key
ROBOMOTION_DASHBOARD_URL=https://dashboard.example

ROBOMOTION_POSE_MAX_HEIGHT=720
ROBOMOTION_POSE_FPS=24
ROBOMOTION_POSE_MAX_FRAMES=720
GPU_SHM_SIZE=8gb
ROBOMOTION_MOTION_GPU=all
ROBOMOTION_TRAINING_GPU=all
HF_TOKEN=

SMPLX_USERNAME_SECRET_FILE=/secure/secrets/smplx_username.txt
SMPLX_PASSWORD_SECRET_FILE=/secure/secrets/smplx_password.txt
SMPL_USERNAME_SECRET_FILE=/secure/secrets/smpl_username.txt
SMPL_PASSWORD_SECRET_FILE=/secure/secrets/smpl_password.txt
