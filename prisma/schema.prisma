generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  DRAFT
  PREFLIGHTED
  QUEUED
  DISPATCHING
  RUNNING
  WAITING_REVIEW
  SUCCEEDED
  FAILED
  CANCELLED
  BLOCKED
}

enum StageStatus {
  PENDING
  READY
  LEASED
  RUNNING
  AWAITING_REVIEW
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_TERMINAL
  CANCELLED
  SKIPPED
}

enum PipelineStage {
  VIDEO_GENERATION
  POSE_EXTRACTION
  POSE_REVIEW
  ROBOT_RETARGETING
  VISUALIZATION
  TRAINING
  POLICY_EVALUATION
  SIMULATION_VERIFICATION
}

enum AssetType {
  VIDEO_SOURCE
  VIDEO_GENERATED
  POSE_SMPLX
  POSE_REVIEWED
  MOTION_ROBOT
  VISUALIZATION
  TRAINING_DATASET
  POLICY_CHECKPOINT
  EVALUATION_REPORT
  SIMULATION_EVIDENCE
}

enum AssetApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum CostKind {
  ESTIMATED
  OBSERVED
  RECONCILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StageArtifactRole {
  INPUT
  OUTPUT
  PREVIEW
  EVIDENCE
}

enum ArtifactExportKind {
  DIGITAL_TWIN_MP4
}

enum ArtifactExportStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Workspace {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  projects            Project[]
  assets              Asset[]
  jobs                Job[]
  rateCards           RateCard[]
  computeResources    ComputeResource[]
  computeLeases       ComputeLease[]
  robotModels         RobotModel[]
  trainingRecipes     TrainingRecipe[]
  trainingRuns        TrainingRun[]
  policies            Policy[]
  evaluationRuns      EvaluationRun[]
  simulationScenarios SimulationScenario[]
  simulationRuns      SimulationRun[]
  budgets             Budget[]
  budgetAlerts        BudgetAlert[]
  artifactExports     ArtifactExport[]
}

model WorkerHeartbeat {
  workerId   String   @id
  status     String
  detail     String?
  lastSeenAt DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs        Job[]

  @@unique([workspaceId, name])
}

model Asset {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  type        AssetType
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    AssetVersion[]

  @@index([workspaceId, type])
}

model AssetVersion {
  id             String              @id @default(cuid())
  assetId        String
  version        Int
  schemaVersion  String
  storageKey     String
  contentType    String
  byteSize       BigInt
  checksum       String
  approvalStatus AssetApprovalStatus @default(DRAFT)
  metadata       Json                @default("{}")
  createdAt      DateTime            @default(now())
  asset          Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inputJobs      Job[]               @relation("JobInputAsset")
  stageArtifacts StageArtifact[]
  exportSources  ArtifactExport[]    @relation("ArtifactExportSource")
  exportOutputs  ArtifactExport[]    @relation("ArtifactExportOutput")

  @@unique([assetId, version])
  @@unique([storageKey])
}

model Job {
  id                  String            @id @default(cuid())
  workspaceId         String
  projectId           String
  inputAssetVersionId String?
  name                String
  robotModel          String
  startStage          PipelineStage
  endStage            PipelineStage
  status              JobStatus         @default(DRAFT)
  plan                Json
  estimateMinor       Int               @default(0)
  estimateCurrency    String            @default("USD")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inputAssetVersion   AssetVersion?     @relation("JobInputAsset", fields: [inputAssetVersionId], references: [id], onDelete: SetNull)
  stages              JobStage[]
  costs               CostLedgerEntry[]
  reviewTasks         ReviewTask[]
  computeLeases       ComputeLease[]
  events              JobEvent[]
  artifactExports     ArtifactExport[]

  @@index([workspaceId, status, createdAt])
  @@index([projectId, createdAt])
}

model JobStage {
  id              String           @id @default(cuid())
  jobId           String
  stage           PipelineStage
  position        Int
  status          StageStatus      @default(PENDING)
  adapter         String
  config          Json             @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempts        StageAttempt[]
  reviewTask      ReviewTask?
  artifacts       StageArtifact[]
  artifactExports ArtifactExport[]

  @@unique([jobId, position])
  @@index([status, createdAt])
}

model StageAttempt {
  id           String        @id @default(cuid())
  jobStageId   String
  attempt      Int
  workerId     String?
  containerRef String?
  status       StageStatus   @default(LEASED)
  startedAt    DateTime?
  endedAt      DateTime?
  result       Json          @default("{}")
  errorCode    String?
  createdAt    DateTime      @default(now())
  jobStage     JobStage      @relation(fields: [jobStageId], references: [id], onDelete: Cascade)
  computeLease ComputeLease?

  @@unique([jobStageId, attempt])
}

model ReviewTask {
  id           String             @id @default(cuid())
  jobId        String
  jobStageId   String             @unique
  status       ReviewStatus       @default(PENDING)
  decisionNote String?
  reviewedBy   String?
  createdAt    DateTime           @default(now())
  decidedAt    DateTime?
  job          Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobStage     JobStage           @relation(fields: [jobStageId], references: [id], onDelete: Cascade)
  annotations  ReviewAnnotation[]

  @@index([status, createdAt])
  @@index([jobId, status])
}

model CostLedgerEntry {
  id          String   @id @default(cuid())
  workspaceId String
  jobId       String
  kind        CostKind
  category    String
  provider    String
  amountMinor Int
  currency    String   @default("USD")
  rateCard    String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([jobId, createdAt])
}

model RateCard {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  currency    String         @default("USD")
  active      Boolean        @default(false)
  effectiveAt DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       RateCardItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId, active, effectiveAt])
}

model RateCardItem {
  id          String   @id @default(cuid())
  rateCardId  String
  sku         String
  category    String
  unit        String
  amountMinor Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rateCard    RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@unique([rateCardId, sku])
}

model ComputeResource {
  id          String         @id @default(cuid())
  workspaceId String
  provider    String
  externalId  String
  gpuSku      String
  region      String
  state       String
  gpuCount    Int            @default(0)
  vramGb      Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lastSeenAt  DateTime       @default(now())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leases      ComputeLease[]

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, provider, state])
}

model ComputeLease {
  id             String          @id @default(cuid())
  workspaceId    String
  jobId          String
  stageAttemptId String          @unique
  resourceId     String
  provider       String
  state          String
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  runtimeSeconds Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageAttempt   StageAttempt    @relation(fields: [stageAttemptId], references: [id], onDelete: Cascade)
  resource       ComputeResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, state, startedAt])
  @@index([jobId, startedAt])
}

model JobEvent {
  id        String         @id @default(cuid())
  jobId     String
  type      String
  stage     PipelineStage?
  message   String
  metadata  Json           @default("{}")
  createdAt DateTime       @default(now())
  job       Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model ReviewAnnotation {
  id           String     @id @default(cuid())
  reviewTaskId String
  kind         String
  startMs      Int?
  endMs        Int?
  payload      Json       @default("{}")
  createdBy    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reviewTask   ReviewTask @relation(fields: [reviewTaskId], references: [id], onDelete: Cascade)

  @@index([reviewTaskId, createdAt])
}

model StageArtifact {
  id             String            @id @default(cuid())
  jobStageId     String
  assetVersionId String
  role           StageArtifactRole
  createdAt      DateTime          @default(now())
  jobStage       JobStage          @relation(fields: [jobStageId], references: [id], onDelete: Cascade)
  assetVersion   AssetVersion      @relation(fields: [assetVersionId], references: [id], onDelete: Restrict)

  @@unique([jobStageId, assetVersionId, role])
  @@index([assetVersionId])
}

model ArtifactExport {
  id                        String               @id @default(cuid())
  workspaceId               String
  jobId                     String
  jobStageId                String
  kind                      ArtifactExportKind
  status                    ArtifactExportStatus @default(QUEUED)
  sourceSceneAssetVersionId String
  outputAssetVersionId      String?
  progressCurrent           Int                  @default(0)
  progressTotal             Int?
  attempts                  Int                  @default(0)
  workerId                  String?
  config                    Json                 @default("{}")
  errorMessage              String?
  startedAt                 DateTime?
  finishedAt                DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  workspace                 Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job                       Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobStage                  JobStage             @relation(fields: [jobStageId], references: [id], onDelete: Cascade)
  sourceSceneAssetVersion   AssetVersion         @relation("ArtifactExportSource", fields: [sourceSceneAssetVersionId], references: [id], onDelete: Restrict)
  outputAssetVersion        AssetVersion?        @relation("ArtifactExportOutput", fields: [outputAssetVersionId], references: [id], onDelete: SetNull)

  @@unique([jobStageId, kind])
  @@index([status, createdAt])
  @@index([workspaceId, status, createdAt])
}

model RobotModel {
  id          String               @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  dof         Int
  active      Boolean              @default(true)
  config      Json                 @default("{}")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policies    Policy[]
  scenarios   SimulationScenario[]

  @@unique([workspaceId, slug])
}

model TrainingRecipe {
  id          String        @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  algorithm   String
  config      Json          @default("{}")
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        TrainingRun[]

  @@unique([workspaceId, slug])
}

model TrainingRun {
  id          String         @id @default(cuid())
  workspaceId String
  jobId       String?        @unique
  recipeId    String
  policyId    String?
  name        String
  status      String
  metrics     Json           @default("{}")
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipe      TrainingRecipe @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  policy      Policy?        @relation(fields: [policyId], references: [id], onDelete: SetNull)
}

model Policy {
  id           String          @id @default(cuid())
  workspaceId  String
  robotModelId String
  name         String
  status       String          @default("CANDIDATE")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  robotModel   RobotModel      @relation(fields: [robotModelId], references: [id], onDelete: Restrict)
  versions     PolicyVersion[]
  trainingRuns TrainingRun[]

  @@unique([workspaceId, name])
}

model PolicyVersion {
  id                       String          @id @default(cuid())
  policyId                 String
  version                  Int
  status                   String          @default("CANDIDATE")
  checkpointAssetVersionId String?
  metrics                  Json            @default("{}")
  promotedAt               DateTime?
  createdAt                DateTime        @default(now())
  policy                   Policy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  evaluations              EvaluationRun[]
  simulations              SimulationRun[]

  @@unique([policyId, version])
}

model EvaluationRun {
  id              String        @id @default(cuid())
  workspaceId     String
  jobId           String?       @unique
  policyVersionId String
  status          String
  metrics         Json          @default("{}")
  passed          Boolean?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
}

model SimulationScenario {
  id           String          @id @default(cuid())
  workspaceId  String
  robotModelId String
  slug         String
  name         String
  config       Json            @default("{}")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  robotModel   RobotModel      @relation(fields: [robotModelId], references: [id], onDelete: Restrict)
  runs         SimulationRun[]

  @@unique([workspaceId, slug])
}

model SimulationRun {
  id               String             @id @default(cuid())
  workspaceId      String
  jobId            String?            @unique
  policyVersionId  String
  scenarioId       String
  status           String
  passed           Boolean?
  metrics          Json               @default("{}")
  verificationNote String?
  verifiedBy       String?
  verifiedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policyVersion    PolicyVersion      @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  scenario         SimulationScenario @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
}

model Budget {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  category     String?
  limitMinor   Int
  currency     String        @default("USD")
  alertPercent Int           @default(80)
  enforcement  String        @default("WARN")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  alerts       BudgetAlert[]

  @@unique([workspaceId, name])
  @@index([workspaceId, active])
}

model BudgetAlert {
  id            String    @id @default(cuid())
  workspaceId   String
  budgetId      String
  jobId         String?
  level         String
  message       String
  forecastMinor Int
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([budgetId, createdAt])
}
